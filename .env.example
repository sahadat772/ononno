# Copy to .env.local / Vercel Environment Variables

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Gemini for curriculum / Groq for student AI) ──────
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults try llama-3.1-8b-instant then 3.3-70b)
GROQ_MODEL=
GROQ_QUIZ_MODEL=

# ── Curriculum storage ────────────────────────────────────
# supabase | google_drive
CURRICULUM_STORAGE_PROVIDER=google_drive

# Google Drive (required only if CURRICULUM_STORAGE_PROVIDER=google_drive)
GOOGLE_DRIVE_CLIENT_EMAIL=ononno-drive@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# Cover images: branded (default) | pollinations | gemini | auto
COVER_IMAGE_PROVIDER=branded

# ── Site URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ononno-two.vercel.app

# ── Payments ──────────────────────────────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
