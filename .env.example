# ═══════════════════════════════════════════════════════════
# ONONNO — Environment Variables (Production + Local)
# Vercel → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Supabase (required) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# proxy.ts uses PUBLISHABLE_KEY; some libs still read ANON_KEY — set both to same value if needed
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (required for curriculum) ──────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Curriculum storage ────────────────────────────────────
# supabase | google_drive
CURRICULUM_STORAGE_PROVIDER=google_drive

# Google Drive (required only if CURRICULUM_STORAGE_PROVIDER=google_drive)
GOOGLE_DRIVE_CLIENT_EMAIL=ononno-drive@YOUR_PROJECT.iam.gserviceaccount.com
# Paste full private key; use real newlines OR \n escaped in one line
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Folder ID only (not full URL / not ?usp=sharing)
GOOGLE_DRIVE_FOLDER_ID=

# Cover images: branded (default, recommended) | pollinations | gemini | auto
COVER_IMAGE_PROVIDER=branded

# ── Site URL (auth redirects) ─────────────────────────────
NEXT_PUBLIC_APP_URL=https://ononno-two.vercel.app

# ── Firebase / notifications (optional) ───────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Payments ──────────────────────────────────────────────
# bKash — sandbox for test; production URL when going live
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
